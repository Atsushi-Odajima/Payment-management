# ── Database ───────────────────────────────────────────────────────────────
# SQLite for local dev. On Vercel set a postgresql:// URL (Neon etc.) — the
# build step switches the Prisma provider automatically.
DATABASE_URL="file:./dev.db"

# ── Encryption (required) ──────────────────────────────────────────────────
# AES-256-GCM key for provider credentials: base64 of 32 random bytes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production refuses to start without a valid key (fail-closed). Set it BEFORE
# seeding; if you rotate it, existing secrets become undecryptable and must be
# re-entered (locally: rm prisma/dev.db && npx prisma migrate deploy && npm run db:seed).
ENCRYPTION_KEY="REPLACE_WITH_32BYTE_BASE64_KEY"

# ── Admin login (recommended) ──────────────────────────────────────────────
# When set, every mutation (create/capture/refund, provider changes) requires
# a login; reads stay public. Unset = open demo with a visible warning banner.
# ADMIN_PASSWORD="change-me"
# Shown on the login page so demo visitors can get in. Omit in real deployments.
# DEMO_LOGIN_HINT="change-me"
# HMAC key for the session cookie. Falls back to ENCRYPTION_KEY when unset.
# SESSION_SECRET=""

# ── Public demo hardening (optional) ───────────────────────────────────────
# "1" blocks DELETE and provider PATCH so visitors cannot wipe the demo data.
# DEMO_READONLY="1"
# Enables POST/GET /api/demo/reset (Authorization: Bearer <secret>); Vercel Cron
# sends this header automatically when CRON_SECRET is configured.
# CRON_SECRET=""
