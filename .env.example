# ── Database ───────────────────────────────────────────────────────────────
# SQLite for local dev. On Vercel set a postgresql:// URL (Neon etc.) — the
# build step switches the Prisma provider automatically.
DATABASE_URL="file:./dev.db"

# ── Encryption (required) ──────────────────────────────────────────────────
# AES-256-GCM key for provider credentials: base64 of 32 random bytes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production refuses to start without a valid key (fail-closed). Set it BEFORE
# seeding; if you rotate it, existing secrets become undecryptable and must be
# re-entered (locally: rm prisma/dev.db && npx prisma migrate deploy && npm run db:seed).
ENCRYPTION_KEY="REPLACE_WITH_32BYTE_BASE64_KEY"

# ── Admin login ────────────────────────────────────────────────────────────
# Operators are AdminUser rows (login id + scrypt password, optional TOTP).
# The seed creates the master account "kuromaru" and the general account
# "general" (prisma/seed-accounts.ts). Mutations require a session; the top
# page asks for a login once, reads stay public.
# Set to any value to list the demo accounts on the login page (public demo).
# DEMO_LOGIN_HINT="1"
# Password of the seeded general account (default: general1234).
# DEMO_GENERAL_PASSWORD=""
# HMAC key for the session cookie. Falls back to ENCRYPTION_KEY when unset.
# SESSION_SECRET=""

# ── Public demo hardening (optional) ───────────────────────────────────────
# "1" blocks DELETE and provider PATCH so visitors cannot wipe the demo data.
# DEMO_READONLY="1"
# Enables POST/GET /api/demo/reset and /api/cron/expire-transfers (hourly:
# overdue bank transfers → expired) with Authorization: Bearer <secret>; Vercel
# Cron sends this header automatically when CRON_SECRET is configured.
# CRON_SECRET=""
# Bearer token for POST /api/demo/deposit-notify (simulated bank deposit
# notification). Required in production; when unset the endpoint is open in
# development and disabled (404) in production.
# DEPOSIT_NOTIFY_SECRET=""
