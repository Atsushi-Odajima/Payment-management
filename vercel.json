{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/prepare-prisma.mjs && prisma generate && prisma db push --skip-generate --accept-data-loss && next build && tsx prisma/seed.ts",
  "framework": "nextjs",
  "regions": ["hnd1"],
  "crons": [
    { "path": "/api/demo/reset", "schedule": "0 18 * * *" },
    { "path": "/api/cron/expire-transfers", "schedule": "0 * * * *" },
    { "path": "/api/cron/webhook-retry", "schedule": "30 * * * *" },
    { "path": "/api/cron/subscriptions", "schedule": "15 * * * *" }
  ]
}
