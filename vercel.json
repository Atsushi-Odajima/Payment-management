{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/prepare-prisma.mjs && prisma generate && prisma db push --skip-generate --accept-data-loss && next build && tsx prisma/seed.ts",
  "framework": "nextjs",
  "regions": ["hnd1"],
  "crons": [
    { "path": "/api/demo/reset", "schedule": "0 18 * * *" },
    { "path": "/api/cron/expire-transfers", "schedule": "0 1 * * *" },
    { "path": "/api/cron/webhook-retry", "schedule": "30 1 * * *" },
    { "path": "/api/cron/subscriptions", "schedule": "15 2 * * *" },
    { "path": "/api/cron/payment-method-controls", "schedule": "45 2 * * *" },
    { "path": "/api/cron/notifications", "schedule": "50 3 * * *" },
    { "path": "/api/cron/anonymize", "schedule": "0 19 * * *" }
  ]
}
