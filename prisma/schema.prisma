// Prisma schema for the payment management dashboard.
//
// Local development uses SQLite. On Vercel, scripts/prepare-prisma.mjs
// rewrites the datasource provider from DATABASE_URL (postgresql://…) at
// build time, so this file is never edited by hand for deploys.
//
// Enums are modeled as String because SQLite has no native enum support;
// the application narrows them at the boundary (lib/payments/transitions.ts,
// lib/utils.ts) so no raw string leaks into the UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PaymentProvider {
  id          String   @id @default(cuid())
  category    String
  providerKey String
  displayName String
  // "active" | "disabled" — see PROVIDER_STATUSES. Providers with payments
  // are disabled rather than deleted (Restrict below) so the ledger survives.
  status      String   @default("active")
  // JSON-encoded map of credential field key -> AES-GCM ciphertext for secret
  // fields, plaintext for non-secret fields (see lib/providers/credentials.ts).
  credentials String
  // Reserved for per-provider options (fee rate, capture policy). Unused today.
  settings    String   @default("{}")
  testMode    Boolean  @default(true)
  lastTestAt  DateTime?
  lastTestOk  Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments      Payment[]
  webhookEvents WebhookEvent[]

  @@index([category])
  @@index([providerKey])
}

model Payment {
  id                String    @id @default(cuid())
  providerId        String
  // Restrict: a provider that has payments cannot be deleted (409 from the
  // API). Transaction history outlives connection settings.
  provider          PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  externalId        String?
  orderNumber       String
  customerName      String?
  customerEmail     String?
  // JPY has no minor unit, so amounts are whole yen.
  amount            Int
  currency          String    @default("JPY")
  // Sum of all refunds so far; status becomes partially_refunded / refunded.
  amountRefunded    Int       @default(0)
  // One of PAYMENT_STATUSES (lib/payments/transitions.ts).
  status            String    @default("pending")
  // Snapshot of provider.testMode at creation so flipping a provider to live
  // later never re-labels historical test payments.
  livemode          Boolean   @default(false)
  // Client-supplied Idempotency-Key; a retry with the same key returns the
  // original payment instead of creating a duplicate.
  idempotencyKey    String?   @unique
  description       String?
  metadata          String    @default("{}")
  // ── Transaction (決済申請) fields ──────────────────────────────────────
  // The merchant (加盟店) whose checkout created this transaction. Optional so
  // rows created before merchants existed stay valid.
  merchantId        String?
  merchant          Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  // Payment method snapshot at creation: credit | qr | convenience | bank | other
  // (lib/payments/methods.ts). Falls back to provider.category when null.
  method            String?
  productName       String?
  // Merchant-side user id (ユーザーID) of the buyer.
  customerId        String?
  // Bank transfer (銀行振込) only: the transfer id the customer writes on the
  // remittance (7 or 8 digits per Merchant.transferIdDigits), its deadline,
  // the amount received so far and the short / excess flag set by reconciliation.
  transferId        String?   @unique
  transferDueAt     DateTime?
  depositAmount     Int?
  depositDiff       String?
  // Why a transaction was recorded as failed at creation, e.g.
  // "limit_exceeded:daily" (lib/merchants/limits.ts) or "blocked" (Phase F).
  failureReason     String?
  // Risk (Phase F): pseudo card fingerprint (sha256 of brand|last4|expiry),
  // the visible last 4 digits and the checkout's source IP.
  cardHash          String?
  cardLast4         String?
  clientIp          String?
  // Follow-up state of a short / excess deposit: open | refund_arranged |
  // notified | resolved (lib/risk/deposit-diffs.ts).
  depositDiffStatus String?
  // Origin (Phase H): the payment link or subscription that produced the transaction.
  paymentLinkId     String?
  paymentLink       PaymentLink?  @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)
  // Bank transfer only: the last manual "re-notify" of the merchant (API 再通知) and how many were sent.
  renotifiedAt      DateTime?
  renotifyCount     Int       @default(0)
  // Konbini (Phase K-1): store brand (seven | lawson | familymart | ministop |
  // other), the 13-digit payment slip number the customer quotes at the till
  // and when it was paid. The deadline reuses transferDueAt.
  cvsBrand          String?
  cvsReceiptNo      String?   @unique
  cvsPaidAt         DateTime?
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // Completion time (完了日時): stamped when the status becomes captured.
  capturedAt        DateTime?
  cancelledAt       DateTime?
  refundedAt        DateTime?

  refunds     Refund[]
  events      PaymentEvent[]
  chargebacks Chargeback[]
  unmatchedDeposits UnmatchedDeposit[]
  notes             TransactionNote[]
  receipt           Receipt?

  @@unique([providerId, externalId])
  @@index([providerId])
  @@index([merchantId])
  @@index([status])
  @@index([createdAt])
  @@index([transferDueAt])
  @@index([livemode])
  @@index([cardHash])
  @@index([clientIp])
  @@index([depositDiffStatus])
  @@index([paymentLinkId])
  @@index([subscriptionId])
}

// One row per refund request (Phase C). A general operator files a request
// (status requested); a master approves (→ completed, the payment moves to
// partially_refunded / refunded through the state machine) or rejects it.
// Rows written by webhooks / seed are completed directly. Full history is
// preserved even after the payment reaches "refunded".
model Refund {
  id            String     @id @default(cuid())
  paymentId     String
  payment       Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // Snapshot of payment.merchantId / livemode for list filters.
  merchantId    String?
  livemode      Boolean    @default(false)
  amount        Int
  // full | partial (lib/refunds/types.ts)
  kind          String     @default("partial")
  // customer | defect | duplicate | other
  reasonCode    String     @default("other")
  // Free-text reason (required for "other").
  reason        String?
  // requested | approved | rejected | processing | completed | failed
  status        String     @default("completed")
  // Master override of the merchant's refund window (reason required).
  forced        Boolean    @default(false)
  requestedById String?
  requestedBy   AdminUser? @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    AdminUser? @relation("RefundApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  // Note left by the master on approval / rejection.
  decisionNote  String?
  createdAt     DateTime   @default(now())
  completedAt   DateTime?

  @@index([paymentId])
  @@index([status, createdAt])
  @@index([merchantId])
}

// Append-only audit trail of every status change on a payment.
model PaymentEvent {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // "created" | "capture" | "cancel" | "refund" | "fail" | "expire" | "deposit"
  type       String
  fromStatus String?
  toStatus   String?
  amount     Int?
  // Who triggered it: "dashboard" | "webhook" | "bank" | "seed" | "system"
  actor      String   @default("dashboard")
  createdAt  DateTime @default(now())

  @@index([paymentId, createdAt])
}

// Merchant (加盟店) accounts managed by the PSP operator. The merchant password
// is encrypted with the same AES-GCM key as provider credentials and is only
// revealed to the "master" role (see lib/role.ts).
model Merchant {
  methodControls PaymentMethodControl[]
  id                String   @id @default(cuid())
  // Auto-numbered public identifier, MER-00001 …
  merchantCode      String   @unique
  passwordEnc       String
  siteName          String
  siteNameKana      String
  companyName       String
  contactName       String
  email             String
  statementEmail    String
  // HTTPS endpoint that receives payment-result notifications (webhooks).
  notifyUrl         String
  // json_post | form_post | query_get      (lib/merchants/types.ts)
  notifyFormat      String   @default("json_post")
  // minimal | standard | full
  notifyParamSet    String   @default("standard")
  // payment_id | transaction_id | both
  notifyIdFormat    String   @default("payment_id")
  // per_payment | daily | none
  emailNotification String   @default("per_payment")
  // Referring agent (代理店); optional.
  agentId           String?
  agent             Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  // JSON array of payment methods the merchant may offer, e.g. ["credit","qr"]
  // (lib/payments/methods.ts). Edited on the merchant form.
  enabledMethods    String   @default("[]")
  // Length of the bank-transfer id issued to this merchant's customers: 7 or 8.
  transferIdDigits  Int      @default(7)
  // Days a customer has to complete a bank transfer (振込期限), counted from
  // the application; and days after completion during which a refund may be
  // requested (返金可能期限).
  transferDueDays   Int      @default(7)
  refundWindowDays  Int      @default(180)
  // Days a customer has to pay at the konbini counter (Phase K-1).
  cvsDueDays        Int      @default(3)
  // Qualified-invoice data of the merchant (Phase K-3): its own registration
  // number (T + 13 digits, optional) and postal address printed on invoices.
  invoiceNumber     String?
  address           String?
  // ── Settlement settings (Phase D, lib/settlements/types.ts) ─────────────
  // monthly | semimonthly | weekly
  settlementCycle   String   @default("monthly")
  // next_month_end | next_month_15 | month_after_next_15 | next_week
  payoutTerm        String   @default("next_month_end")
  bankName          String?
  bankBranch        String?
  // ordinary | current
  bankAccountType   String?
  bankAccountNumber String?
  bankAccountHolder String?
  // Transfer fee deducted from every payout (yen).
  settlementFee     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payments       Payment[]
  ipRestrictions IpRestriction[]
  feeSchedules   MerchantFeeSchedule[]
  limits         MerchantLimit[]
  apiKeys        ApiKey[]
  settlements    SettlementBatch[]
  webhookDeliveries WebhookDelivery[]
  plans          Plan[]
  subscriptions  Subscription[]
  paymentLinks   PaymentLink[]

  @@index([createdAt])
  @@index([agentId])
}

// Agent (代理店) that refers / brokers merchants. Auto-numbered AGT-00001.
model Agent {
  id          String   @id @default(cuid())
  agentCode   String   @unique
  name        String
  nameKana    String
  companyName String
  contactName String
  email       String
  // Commission rate in percent (e.g. 3.5).
  feeRate     Float    @default(0)
  // active | disabled
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchants Merchant[]

  @@index([createdAt])
}

// IP rules for the admin UI and the merchant API. "deny" rules block matching
// callers (enforced for the admin target in app/layout.tsx and
// lib/api/handler.ts); "allow" rules form the informational allow-list.
model IpRestriction {
  id         String    @id @default(cuid())
  // admin | merchant_api
  target     String
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // IPv4 address or CIDR, e.g. 203.0.113.10 or 203.0.113.0/24
  cidr       String
  label      String
  // allow | deny (lib/ip-restrictions/types.ts)
  mode       String    @default("allow")
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([target, enabled])
  @@index([merchantId])
}

// Contract plan and fee rates of a merchant, versioned by effective date:
// the row with the latest effectiveFrom <= now is the current contract
// (lib/merchants/fees.ts). rates is JSON: { credit: { ratePercent, fixedFee }, … }.
model MerchantFeeSchedule {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // standard | premium | custom
  plan          String
  rates         String
  effectiveFrom DateTime
  note          String?
  createdAt     DateTime @default(now())

  @@index([merchantId, effectiveFrom])
}

// Per-method transaction limits (yen). null = unlimited.
model MerchantLimit {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // credit | qr | convenience | bank
  method         String
  perTransaction Int?
  daily          Int?
  monthly        Int?
  updatedAt      DateTime @updatedAt

  @@unique([merchantId, method])
}

// Merchant API credentials. Only the SHA-256 hash is stored; the plaintext is
// returned once at issue / rotation. kind: api_key | signing_secret,
// mode: test | live. A rotated key keeps working until expiresAt.
model ApiKey {
  id         String    @id @default(cuid())
  merchantId String
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  mode       String
  kind       String
  label      String?
  keyPrefix  String
  keyHash    String    @unique
  // Signing secrets only: AES-GCM ciphertext of the plaintext so outbound
  // webhooks can be signed with it (lib/merchants/secrets.ts).
  secretEnc  String?
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([merchantId, mode, kind])
}

// Operators of this dashboard. Passwords are scrypt hashes; the TOTP secret
// is AES-GCM encrypted (lib/admin/secrets.ts). role: master | general,
// status: active | disabled | invited (invited = created, never logged in).
model AdminUser {
  notes         TransactionNote[]
  notificationPreferences NotificationPreference[]
  receiptsIssued Receipt[]
  id            String    @id @default(cuid())
  loginId       String    @unique
  name          String
  email         String    @unique
  role          String    @default("general")
  status        String    @default("active")
  passwordHash  String
  totpSecretEnc String?
  totpEnabled   Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs        AuditLog[]
  refundsRequested Refund[]   @relation("RefundRequestedBy")
  refundsApproved  Refund[]   @relation("RefundApprovedBy")

  @@index([status])
}

// Append-only audit trail of every data change (lib/audit.ts recordAudit).
// actorType: admin | system | webhook | bank | cron | seed; actorId is set for
// admin actors. before / after hold redacted JSON snapshots.
model AuditLog {
  id         String     @id @default(cuid())
  actorType  String     @default("admin")
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  before     String?
  after      String?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action])
}

// Inbound provider notifications, deduplicated on (provider, external event id).
model WebhookEvent {
  id              String    @id @default(cuid())
  providerId      String
  provider        PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  externalEventId String
  type            String
  payload         String
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  error           String?

  @@unique([providerId, externalEventId])
  @@index([receivedAt])
}

// Settlement batch (精算バッチ, Phase D): one payout per merchant and period.
// Amounts are aggregated from the lines when the batch is generated
// (lib/settlements/service.ts). status: collecting | confirmed | scheduled |
// paid | held. Test-mode batches are marked livemode=false and are never paid
// in production; they exist so the demo can show the flow.
model SettlementBatch {
  id               String   @id @default(cuid())
  merchantId       String
  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  livemode         Boolean  @default(false)
  periodFrom       DateTime
  // Exclusive end of the period.
  periodTo         DateTime
  grossAmount      Int      @default(0)
  feeAmount        Int      @default(0)
  refundAmount     Int      @default(0)
  chargebackAmount Int      @default(0)
  settlementFee    Int      @default(0)
  netAmount        Int      @default(0)
  status           String   @default("collecting")
  scheduledAt      DateTime?
  paidAt           DateTime?
  holdReason       String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lines SettlementLine[]

  @@unique([merchantId, livemode, periodFrom, periodTo])
  @@index([status, scheduledAt])
  @@index([merchantId, createdAt])
}

// Line of a settlement batch: a completed payment (positive amount + fee), a
// completed refund or a lost chargeback (negative amount). kind: payment |
// refund | chargeback. Source ids are plain strings so a deleted source
// never breaks the ledger.
model SettlementLine {
  id           String          @id @default(cuid())
  batchId      String
  batch        SettlementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  kind         String
  paymentId    String?
  refundId     String?
  chargebackId String?
  method       String?
  description  String?
  amount       Int
  fee          Int             @default(0)
  occurredAt   DateTime
  // Consumption-tax category of the fee (Phase K-3): standard10 | reduced8 | exempt.
  taxCategory  String?

  @@index([batchId])
}

// Chargeback (Phase F; the table exists from Phase D so settlements can
// deduct lost / confirmed chargebacks). reasonCode: fraud | not_received |
// not_as_described | duplicate | other. status: received | disputed | won |
// lost | confirmed.
model Chargeback {
  id                String    @id @default(cuid())
  paymentId         String
  payment           Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  merchantId        String?
  livemode          Boolean   @default(false)
  amount            Int
  reasonCode        String    @default("other")
  status            String    @default("received")
  disputeDeadlineAt DateTime?
  evidenceNote      String?
  occurredAt        DateTime  @default(now())
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([paymentId])
  @@index([status, disputeDeadlineAt])
  @@index([merchantId])
}

// Outbound merchant notification (Phase E). One row per event to deliver;
// each try is a WebhookAttempt. status: pending | success | failed |
// retrying | abandoned. Retries follow RETRY_DELAYS_MS in lib/webhooks/deliver.ts.
model WebhookDelivery {
  id             String    @id @default(cuid())
  merchantId     String
  merchant       Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentId      String?
  livemode       Boolean   @default(false)
  // payment.completed | payment.failed | payment.expired | refund.completed |
  // chargeback.opened | limit.exceeded | subscription.* (lib/webhooks/events.ts)
  event          String
  url            String
  method         String    @default("POST")
  requestHeaders String    @default("{}")
  requestBody    String?
  responseStatus Int?
  // First 1 KB of the last response body.
  responseBody   String?
  attempts       Int       @default(0)
  status         String    @default("pending")
  nextRetryAt    DateTime?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attemptLog WebhookAttempt[]

  @@index([merchantId, createdAt])
  @@index([status, nextRetryAt])
  @@index([paymentId])
}

model WebhookAttempt {
  id             String          @id @default(cuid())
  deliveryId     String
  delivery       WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNo      Int
  sentAt         DateTime        @default(now())
  responseStatus Int?
  responseBody   String?
  error          String?
  durationMs     Int?
  // dashboard (manual resend) | system | cron
  trigger        String          @default("system")

  @@index([deliveryId, attemptNo])
}

// Global fraud-detection thresholds (single row, id "global"): M failures
// from the same card / IP / email within N minutes create a blacklist candidate.
model RiskSetting {
  id            String   @id @default("global")
  windowMinutes Int      @default(10)
  maxFailures   Int      @default(3)
  // Demo: percentage of subscription charges that fail (Phase H-1).
  demoChargeFailPercent Int @default(20)
  updatedAt     DateTime @updatedAt
}

// Blacklist (Phase F). kind: card | ip | email; source: auto | manual;
// status: candidate | active | disabled | rejected. Active entries block
// matching transactions at creation (failureReason "blocked:<kind>").
model Blacklist {
  id          String   @id @default(cuid())
  kind        String
  value       String
  reason      String?
  source      String   @default("manual")
  status      String   @default("active")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kind, value])
  @@index([status, kind])
}

// Email templates (Phase G-2), one row per (key, lang). Body uses
// {{placeholder}} tokens (lib/email/templates.ts).
model EmailTemplate {
  id        String   @id @default(cuid())
  // transfer_guide | payment_completed | refund_completed | deposit_short | statement | admin_invite
  key       String
  // ja | en
  lang      String
  subject   String
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([key, lang])
}

// Every email the system produced. status: sent | failed | demo (the demo
// provider records instead of sending).
model EmailLog {
  id          String   @id @default(cuid())
  to          String
  templateKey String
  lang        String
  subject     String
  body        String
  status      String   @default("demo")
  provider    String   @default("log")
  error       String?
  paymentId   String?
  merchantId  String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([paymentId])
  @@index([templateKey, status])
}

// Announcements (Phase G-3). kind: notice | maintenance | incident;
// status: draft | published | ended. targetMerchantIds is a JSON array of
// merchant ids (empty + targetAll = everyone). Incidents keep a timeline of
// AnnouncementUpdate rows (occurred → investigating → resolved).
model Announcement {
  id                String   @id @default(cuid())
  kind              String   @default("notice")
  title             String
  body              String
  publishFrom       DateTime @default(now())
  publishUntil      DateTime?
  targetAll         Boolean  @default(true)
  targetMerchantIds String   @default("[]")
  status            String   @default("draft")
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  updates AnnouncementUpdate[]

  @@index([status, publishFrom])
}

model AnnouncementUpdate {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  // occurred | investigating | resolved
  phase          String
  body           String
  createdAt      DateTime     @default(now())

  @@index([announcementId, createdAt])
}

// Recurring billing plan (Phase H-1). interval: monthly | yearly | weekly.
model Plan {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  amount     Int
  interval   String   @default("monthly")
  trialDays  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subscriptions Subscription[]

  @@index([merchantId])
}

// Subscription of a merchant's customer to a plan. status: trialing | active
// | past_due | suspended | cancelled. The cron charges when nextChargeAt has
// passed; failures retry after 3 and 7 days, the third failure suspends.
model Subscription {
  id            String    @id @default(cuid())
  merchantId    String
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  customerId    String
  customerName  String
  customerEmail String?
  status        String    @default("active")
  livemode      Boolean   @default(false)
  nextChargeAt  DateTime?
  startedAt     DateTime  @default(now())
  cancelledAt   DateTime?
  lastChargeAt  DateTime?
  failCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments Payment[]

  @@index([status, nextChargeAt])
  @@index([merchantId])
}

// Hosted payment link (Phase H-2): /pay/<token>. status: active | disabled.
model PaymentLink {
  id          String    @id @default(cuid())
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  token       String    @unique
  productName String
  amount      Int
  description String?
  expiresAt   DateTime?
  maxUses     Int?
  usedCount   Int       @default(0)
  status      String    @default("active")
  livemode    Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments Payment[]

  @@index([merchantId, status])
}

/// Bank deposits that arrived without a usable transfer id (振込ID の付け忘れ
/// など). Support attaches the transfer id, which reconciles the transaction
/// and re-notifies the merchant's API so the customer is credited without a
/// manual update on the merchant side.
model UnmatchedDeposit {
  id                String    @id @default(cuid())
  livemode          Boolean   @default(false)
  amount            Int
  payerName         String
  receivedAt        DateTime
  bankReference     String?
  /// What the customer actually wrote on the remittance (wrong / partial), if anything.
  givenTransferId   String?
  note              String?
  /// bank (deposit notification API) | manual (registered by support)
  source            String    @default("manual")
  /// unmatched | matched | dismissed
  status            String    @default("unmatched")
  paymentId         String?
  payment           Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  matchedTransferId String?
  matchedById       String?
  matchedAt         DateTime?
  dismissReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([livemode])
  @@index([receivedAt])
  @@index([paymentId])
}

/// Internal comments on a transaction (Phase I-2). Shown only in the
/// operator dashboard, merged with the status history into one timeline.
model TransactionNote {
  id        String    @id @default(cuid())
  paymentId String
  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  authorId  String
  author    AdminUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([paymentId])
  @@index([authorId])
}

/// Payment method suspension switches (Phase I-3): a global row per method
/// (merchantId null) and optional per-merchant rows. A method is available
/// when neither the global nor the merchant row is suspended and the
/// merchant has it enabled.
model PaymentMethodControl {
  id            String    @id @default(cuid())
  /// global | merchant
  scope         String
  merchantId    String?
  merchant      Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  /// credit | qr | convenience | bank
  method        String
  suspended     Boolean   @default(false)
  reason        String?
  suspendedById String?
  suspendedAt   DateTime?
  /// When set and in the past, the hourly cron resumes the method.
  resumeAt      DateTime?
  resumedAt     DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  @@unique([scope, merchantId, method])
  @@index([suspended])
  @@index([resumeAt])
}

/// Operator notifications (Phase J; the table and the emitter land in Phase I
/// so the payment-method switch can raise critical notices).
model Notification {
  id         String   @id @default(cuid())
  /// e.g. payment_method.suspended, webhook.abandoned, settlement.generated
  kind       String
  /// info | warning | critical
  severity   String   @default("info")
  title      String
  body       String
  href       String?
  /// JSON array of roles that should see it; empty = everyone
  roles      String   @default("[]")
  targetType String?
  targetId   String?
  createdAt  DateTime @default(now())
  /// When the e-mail / Slack fan-out ran (null = pending).
  dispatchedAt DateTime?
  reads      NotificationRead[]
  slackLogs  SlackLog[]

  @@index([kind])
  @@index([severity])
  @@index([createdAt])
  @@index([targetType, targetId])
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  adminUserId    String
  readAt         DateTime     @default(now())

  @@unique([notificationId, adminUserId])
  @@index([adminUserId])
}

/// Single-row global settings (id "global"). Later phases add columns here
/// (Slack URL, invoice issuer, retention periods) instead of new tables.
model GlobalSetting {
  id              String   @id @default("global")
  /// Whether the viewer role may export CSV.
  viewerCsvExport Boolean  @default(false)
  /// Slack Incoming Webhook URL for notification fan-out (Phase J).
  slackWebhookUrl String?
  /// Qualified-invoice issuer (Phase K-3): the PSP's name, registration
  /// number (T + 13 digits), address and phone printed on invoices, and how
  /// consumption tax is rounded per rate (floor | round | ceil).
  issuerName           String?
  issuerRegistrationNo String?
  issuerAddress        String?
  issuerTel            String?
  taxRounding          String   @default("floor")
  updatedAt       DateTime @updatedAt
}

/// Receipt (領収書) issued for a completed transaction (Phase K-2). One row
/// per payment: the number is assigned on the first issue and a re-issue only
/// bumps reissueCount (the PDF is stamped "再発行"). source: dashboard |
/// customer (downloaded from the hosted payment page).
model Receipt {
  id            String    @id @default(cuid())
  receiptNo     String    @unique
  paymentId     String    @unique
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  merchantId    String?
  livemode      Boolean   @default(false)
  recipientName String
  amount        Int
  source        String    @default("dashboard")
  issuedById    String?
  issuedBy      AdminUser? @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  reissueCount  Int       @default(0)
  issuedAt      DateTime  @default(now())
  lastIssuedAt  DateTime  @default(now())

  @@index([merchantId, issuedAt])
}

/// Per-admin channel choice per notification kind (Phase J). In-app is
/// always on; email / slack are opt-in. Missing row = in-app only.
model NotificationPreference {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  kind        String
  email       Boolean   @default(false)
  slack       Boolean   @default(false)
  updatedAt   DateTime  @updatedAt

  @@unique([adminUserId, kind])
}

/// Slack Incoming Webhook send log (Phase J): one row per attempt series.
model SlackLog {
  id             String        @id @default(cuid())
  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  /// sent | failed | demo
  status         String
  attempts       Int           @default(1)
  responseStatus Int?
  error          String?
  text           String
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([status])
}
